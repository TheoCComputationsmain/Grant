# Public URL used in approval links, canonical tags, sitemap, and SDK snippets.
GRANT_PUBLIC_BASE_URL=https://grant-approve.vercel.app

# Required in production. HMAC key used to sign permissions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GRANT_SIGNING_SECRET=

# Required in production: Neon Postgres DSN. This is the primary durable store
# for users, organizations, api_keys, approval_requests, auto_approve_rules,
# login_history, and popup_impressions. Production refuses to boot on SQLite
# unless GRANT_ALLOW_SQLITE_IN_PROD=true is explicitly set (local/dev only).
DATABASE_URL=
GRANT_DB=./grant.db

# Passwordless email magic links and email OTP (/v1/auth/otp, /v1/auth/otp/verify).
# In development, omit all providers to print the one-time code/link to the
# console. In production a provider is required for sign-in by email.
GRANT_EMAIL_PROVIDER=
RESEND_API_KEY=
GRANT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
GRANT_MAGIC_LINK_TTL_MINUTES=30
GRANT_SESSION_DAYS=30

# Private Vercel Blob store for shared gateway and decision state.
# Injected automatically by `vercel storage connect`.
BLOB_STORE_ID=
GRANT_BLOB_PREFIX=grant-state

# Requests per client IP per minute. Set 0 to disable in local tests.
GRANT_RATE_LIMIT_PER_MIN=60

# Omitted-auth demo mode on the public integration endpoints: requests per hour
# per hashed IP (default 20). Valid Authorization: Bearer gr_live_... keys are
# not limited by this demo counter.
GRANT_DEMO_LIMIT_PER_HOUR=20

# Signed webhook callbacks are retried at most this many times (default 2).
GRANT_CALLBACK_MAX_RETRIES=2

# Gateway: seconds the hosted proxy waits for a human before returning a
# pending response with an approval link. Vercel maxDuration is 60s.
GRANT_GATEWAY_WAIT_SECONDS=20

# Allow http:// upstreams in production (normally disabled).
GRANT_ALLOW_HTTP_UPSTREAMS=false

# development | production. Vercel sets VERCEL=1 automatically and is always
# treated as production even if this variable is unset.
GRANT_APP_ENV=development

# Used by the local Python/CLI SDK.
GRANT_BASE_URL=https://grant-approve.vercel.app

# Cashfree hosted monthly forms. Grant only redirects; it does not create links
# through the API or process money. Fixed forms are authoritative. The exact
# names are GRANT_CASHFREE_PLUS_MONTHLY_URL and GRANT_CASHFREE_PRO_MONTHLY_URL
# (not GRANT_CASHFREE_MONTHLY_PLUS_URL / GRANT_CASHFREE_MONTHLY_PRO_URL).
GRANT_CASHFREE_PLUS_MONTHLY_URL=
GRANT_CASHFREE_PRO_MONTHLY_URL=
GRANT_CASHFREE_APP_ID=
GRANT_CASHFREE_SECRET_KEY=
GRANT_CASHFREE_API_VERSION=2026-01-01
GRANT_CASHFREE_MODE=sandbox
GRANT_CASHFREE_WEBHOOK_SECRET=
GRANT_CASHFREE_RETURN_URL=
GRANT_CASHFREE_CURRENCY=INR
# Required in production. Cashfree /links requires a customer_phone; Grant uses
# this server-only value instead of collecting customer PII.
GRANT_CASHFREE_PLACEHOLDER_PHONE=
GRANT_ENTERPRISE_CONTACT_URL=

# Cashfree sends x-webhook-timestamp + x-webhook-signature (base64 HMAC-SHA256).
# GRANT_CASHFREE_WEBHOOK_SECRET above (which may be the Cashfree Secret Key)
# signs both POST /v1/billing/webhook and its alias POST /api/webhooks/cashfree.
# The Grant-format HMAC below remains a legacy fallback:
# X-Grant-Timestamp + X-Grant-Signature: sha256=<hex>.
GRANT_BILLING_WEBHOOK_SECRET=

# Day-27 renewal reminders. Vercel Cron calls the endpoint with Bearer
# GRANT_CRON_SECRET. Delivery requires an HTTPS webhook that accepts
# {to, subject, text, tier, renewal_url}; nothing is sent until it is set.
GRANT_CRON_SECRET=
GRANT_RENEWAL_EMAIL_WEBHOOK_URL=
GRANT_RENEWAL_EMAIL_WEBHOOK_TOKEN=

# Token for the private /ops user-count page and /api/billing/status.
# Browser caches Basic auth; /ops#token=... stores it in sessionStorage without
# sending it in server logs. Also used by scripts/verify_cashfree.py.
GRANT_OPS_TOKEN=

# Ops-only POST /api/webhooks/cashfree/test simulates the signed webhook
# activation path (no money moves). Never set this in production unless you are
# explicitly simulating a billing event.
GRANT_ALLOW_TEST_WEBHOOK=false

# Comma-separated origins allowed to receive approval postMessages.
GRANT_POPUP_ALLOWED_ORIGINS=

# SMS / WhatsApp approval alerts are Pro-tier and coming soon: Grant has no
# SMS provider integration yet, so those rows are labelled accordingly.
# Optional aliases for the Postgres DSN (DATABASE_URL wins):
# NEON_DATABASE_URL=
# GRANT_NEON_DATABASE_URL=
