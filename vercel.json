{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/docs",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60"
        }
      ]
    },
    {
      "source": "/stats",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/v1/billing/renewal-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
